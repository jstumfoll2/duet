<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The values a SteppedSliderPreference moves over: a string-array of whole
         milliseconds, strictly increasing. -->
    <declare-styleable name="SteppedSliderPreference">
        <attr name="sliderSteps" format="reference" />
    </declare-styleable>
    <!-- Saturation the HueSliderPreference swatch is drawn at, to match the surface that
         uses the hue (the trail draws brighter than the theme accent). -->
    <declare-styleable name="HueSliderPreference">
        <attr name="swatchSaturation" format="float" />
    </declare-styleable>
</resources>
